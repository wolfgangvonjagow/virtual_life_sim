title: Game Over.
new-page: true
go-to: eg_menu
on-arrival: {!
Q.game_over = 1;
this.achieve('game_completed');

// Example Achievement
if (Q.var1 == 'Example' && Q.var2 == 10 && Q.var3) {
    this.achieve('example_ach');
/// "_ach" just reinforces that it is an achievement
}
!}

= End


@eg_menu

- #endings
- @end_game: End game.


@example_ending
view-if: not false
title: Example Title
tags: endings
go-to: eg_menu

You got the Example Ending!

= Completed Achievements in this Playthrough



[? if game_achievement_example_ach : **Example Achievement** - You won the Example Achievement. ?]



= Completed Achievements Overall


[? if achievement_example_ach : **Example Achievement** - You won the Example Achievement. ?]

= Incomplete Achievements

[? if not achievement_example_ach : **Example Achievement** - You won the Example Achievement. ?]

@end_game
game-over: true
