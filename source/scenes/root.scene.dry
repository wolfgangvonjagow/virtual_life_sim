@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 2000;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;
// How many actions regarding Relationships have been taken? (Max 2)
Q.relations_actions = 0;
// How many actions regarding Occupation or Education have been taken? (Max 3)
Q.occu_edu_actions = 0;
// How many actions regarding Hobbies have been taken? (Max 2)
Q.hobby_actions = 0;
Q.monthly_income = 0;
Q.relations_unlocked = 1;
Q.attribute_manipulation_unlocked = 1;
Q.attribute_manipulation_locked = 0;
Q.occu_edu_unlocked = 0;
Q.hobby_unlocked = 0;
Q.starting_stress = 10;
Q.monthly_stress = 2;

// friends
Q.friends = ['friend1', 'friend2', 'friend3', 'friend4', 'friend5'];
Q.friend_1_filled = 0;
Q.friend1_name = "0";
Q.friend_2_filled = 0;
Q.friend2_name = "0";
Q.friend_3_filled = 0;
Q.friend3_name = "0";
Q.friend_4_filled = 0;
Q.friend4_name = "0";
Q.friend_5_filled = 0;
Q.friend5_name = "0";

// organizations
Q.trade_union_membership = 0;
Q.political_party_membership = 0;

// Family & Friends relations & Age
Q.father_rel = 50;
Q.mother_relation = 50;
Q.friend1_rel = 50;
Q.friend2_rel = 50;
Q.friend3_rel = 50;
Q.friend4_rel = 50;
Q.friend5_rel = 50;
Q.father_age = 35;
Q.mother_age = 35;
Q.friend1_age = 0;
Q.friend2_age = 0;
Q.friend3_age = 0;
Q.friend4_age = 0;
Q.friend5_age = 0;

// Politics
// Centrist gov/pres gives no buffs/debuffs
// Centre-Left gov/pres gives better minimum wage, lowers costs of public utility, but higher taxes
// Left gov is centre-left but both positive and negative effects are doubled
// Centre-Right gives lower taxes and lower commodity costs, but lower minimum wage, higher costs of public utility, and less tax returns
// Right gives is centre-right but double
Q.government_politics = "Centrist"
Q.president = "Centrist"

// Money over time
Q.bank_records = [];
// Salary over time
Q.salary_records = [];
// Friends over time
Q.friends_records = [];
// Skills over time
Q.skills_records = [];

Q.timers = [];
// Timers - Most should start at 0
Q.example_timer = 0
!}
